# ============================================================
# Configuração LOCAL do Grêmio ETEC Poá
#
# Como usar:
#   1) Copie este arquivo para ".env" (na raiz do projeto):
#        PowerShell:  Copy-Item .env.example .env
#   2) Ajuste os valores para o SEU ambiente.
#
# O arquivo ".env" NUNCA deve ser enviado ao GitHub (já está no .gitignore).
# Este arquivo (.env.example) contém apenas valores fictícios/padrão.
# ============================================================

# ---- Banco de dados (MySQL/MariaDB do WampServer) ----
DB_HOST=localhost
# Porta: 3306 costuma ser o MySQL; 3307 costuma ser o MariaDB do WampServer.
# Confira no ícone do Wamp > "Ferramentas" ou no phpMyAdmin.
DB_PORT=3306
DB_NAME=gremio_etec_poa
DB_USER=root
# No WampServer padrão o root não tem senha. Em outros ambientes, defina uma.
DB_PASS=

# ---- Aplicação ----
# local = desenvolvimento | production = servidor real
APP_ENV=local
# Mostra o link de "esqueci minha senha" na própria tela (modo demonstração,
# pois o servidor local não envia e-mails). É IGNORADO se APP_ENV=production.
APP_EXIBIR_LINK_RECUPERACAO=true
# Remetente dos e-mails de recuperação de senha (quando houver SMTP configurado)
MAIL_REMETENTE=no-reply@gremio-etec-poa.local
